# Copy to .env.production and fill in every value. Never commit the real file.

# --- Core ---
ENVIRONMENT=production
# 32+ random bytes, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`.
# Rotating it signs everyone out and makes stored AI provider keys unreadable.
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
CORS_ORIGINS=https://app.example.com
API_PUBLIC_URL=https://api.example.com
# Public URL of the web app (links in calendar invites). Empty: the first CORS origin.
APP_PUBLIC_URL=https://app.example.com
WEB_CONCURRENCY=2

# --- Postgres ---
POSTGRES_USER=worklio
POSTGRES_PASSWORD=
POSTGRES_DB=worklio
DATABASE_URL=postgresql+asyncpg://worklio:CHANGE_ME@postgres:5432/worklio

# --- Redis ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1

# --- Object storage (AWS S3, Cloudflare R2, MinIO, ...) ---
# Leave S3_ENDPOINT_URL empty for AWS S3.
S3_ENDPOINT_URL=
S3_PUBLIC_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=worklio-uploads

# --- Calls (LiveKit) ---
LIVEKIT_PUBLIC_URL=wss://rtc.example.com
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Public IP of this host (media goes straight to it on 7881/tcp and 7882/udp).
LIVEKIT_NODE_IP=

# --- AI (optional; admins can also add keys in Workspace settings -> AI) ---
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# --- Frontend (baked in at build time) ---
NEXT_PUBLIC_API_URL=https://api.example.com
NEXT_PUBLIC_WS_URL=wss://api.example.com
