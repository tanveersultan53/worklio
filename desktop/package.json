{
  "name": "worklio-desktop",
  "productName": "Worklio",
  "version": "0.1.0",
  "description": "Worklio for macOS, Windows and Linux",
  "homepage": "https://github.com/tanveersultan53/worklio",
  "author": {
    "name": "Worklio contributors",
    "email": "noreply@worklio.app"
  },
  "license": "MIT",
  "private": true,
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "check": "tsc -p jsconfig.json",
    "dist": "electron-builder --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:linux": "electron-builder --linux --publish never"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "electron": "45.2.3",
    "electron-builder": "26.18.1",
    "typescript": "5.9.3"
  }
}
