# Worklio local development settings. Copy to .env: `cp .env.example .env`.
# Every value here is a dev-only placeholder. See docs/CONFIGURATION.md for all settings.

# --- Core ---
ENVIRONMENT=development
# Outside development/test the API refuses to start unless this is >= 32 random bytes,
# e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`.
# Changing it signs everyone out and makes stored workspace AI keys unreadable.
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Comma-separated, matched exactly. For two-account testing add http://127.0.0.1:3000 too.
CORS_ORIGINS=http://localhost:3000
# Public base URL of the API (used for absolute links such as avatar URLs).
API_PUBLIC_URL=http://localhost:8000
# Public URL of the web app (links in calendar invites). Empty: the first CORS origin.
APP_PUBLIC_URL=http://localhost:3000

# --- Postgres ---
POSTGRES_USER=worklio
POSTGRES_PASSWORD=worklio
POSTGRES_DB=worklio
DATABASE_URL=postgresql+asyncpg://worklio:worklio@postgres:5432/worklio

# --- Redis ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1

# --- S3 (SeaweedFS locally) ---
# Must match infra/seaweedfs/s3.json (dev-only credentials).
S3_ENDPOINT_URL=http://s3:8333
S3_ACCESS_KEY=worklio
S3_SECRET_KEY=worklio-secret
S3_BUCKET=worklio-uploads
# URL browsers use to download files (presigned URLs are signed for this host)
S3_PUBLIC_ENDPOINT_URL=http://localhost:8333

# --- Calls & huddles (LiveKit) ---
# The docker-compose LiveKit server runs in --dev mode with the key pair devkey / secret.
# Use your own keys and a wss:// URL in production.
LIVEKIT_PUBLIC_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# --- Worklio AI ---
# Optional; or set keys in Workspace settings → AI (Claude, Gemini or DeepSeek).
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
